# Copy into the backend environment. These are optional: missing/invalid credentials
# disable only external push, never startup, sockets, messages, or in-app notifications.
FIREBASE_NOTIFICATIONS_ENABLED=false
FIREBASE_PROJECT_ID=batgram-notification
# Prefer an absolute path to a private service-account JSON outside the public web root:
FIREBASE_SERVICE_ACCOUNT_PATH=
# Alternatively supply BOTH of these, exclusively on the backend:
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Production/Linux with direct Google access:
FIREBASE_TRANSPORT=direct
# Optional local WSL development: use installed Windows Node when only Windows
# can reach Google. No proxy/listening port is created. Do not use on a Linux server.
# FIREBASE_TRANSPORT=windows
# FIREBASE_WINDOWS_NODE_PATH="/mnt/c/Program Files/nodejs/node.exe"
