// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model OTP {
  id             String   @id @default(uuid())
  userId         Int
  code           String
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  deliveryTarget String? // optional field for debugging/logging

  user User @relation("UserOTPs", fields: [userId], references: [id])

  @@index([userId])
}

model User {
  id          Int          @id @default(autoincrement())
  email       String?          @unique
  phoneNumber String?          @unique
  password    String?
  role        Role             @default(USER)
  profile     Profile?
  chats       ChatParticipant[]
  messages    Message[]
  messageReadStatuses MessageReadStatus[] 
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  uploadedFiles UploadFile[]

  otps OTP[] @relation("UserOTPs")
}

model Profile {
  id        Int     @id @default(autoincrement())
  avatarId String? @unique
  avatar UploadFile? @relation("Avatar", fields: [avatarId], references: [id], onDelete: SetNull)
  firstname String?
  lastname  String?
  address   String?
  user      User    @relation(fields: [userId], references: [id])
  userId    Int     @unique
}

enum ChatMemberRole {
  OWNER
  MEMBER
}

model Chat {
  id            Int            @id @default(autoincrement())
  files UploadFile[]
  isGroup      Boolean           @default(false)
  name         String?           @db.VarChar(100)
  avatarId     String?           @unique
  avatar       UploadFile?       @relation("GroupAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  participants  ChatParticipant[]
  messages      Message[]
  calls         Call[]
  createdAt     DateTime          @default(now())
}

// Call history only; media and SDP/ICE are never stored.
model Call {
  id String @id @default(uuid())
  chatId Int
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  callerId Int
  calleeId Int
  mode String
  status String @default("RINGING")
  createdAt DateTime @default(now())
  answeredAt DateTime?
  connectedAt DateTime?
  endedAt DateTime?
  @@index([callerId, createdAt])
  @@index([calleeId, createdAt])
}

model ChatParticipant {
  id       Int   @id @default(autoincrement())
  user     User     @relation(fields: [userId], references: [id])
  userId   Int
  chat     Chat     @relation(fields: [chatId], references: [id])
  chatId   Int
  role     ChatMemberRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@index([chatId])
  @@unique([userId, chatId]) // Prevent duplicate participation
}

enum MessageKind {
  TEXT
  MEMBER_LEFT
  MEMBER_REMOVED
}

model Message {
  id        Int   @id @default(autoincrement())
  attachments UploadFile[]
  content   String
  kind      MessageKind @default(TEXT)
  chat      Chat     @relation(fields: [chatId], references: [id])
  chatId    Int
  sender    User     @relation(fields: [senderId], references: [id])
  senderId  Int
  createdAt DateTime @default(now())
  readStatuses MessageReadStatus[]
}

model MessageReadStatus {
  id        Int      @id @default(autoincrement())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  readAt    DateTime @default(now())

  @@unique([messageId, userId]) // prevent duplicate read status

  @@index([userId, messageId])
  @@index([messageId])
}
model UploadFile {
  id String @id @default(uuid())
  storageKey String @unique
  kind String
  mimeType String
  size Int
  width Int
  height Int
  duration Float?
  ownerId Int
  owner User @relation(fields: [ownerId], references: [id])
  chatId Int?
  chat Chat? @relation(fields: [chatId], references: [id])
  messageId Int?
  message Message? @relation(fields: [messageId], references: [id])
  avatar Profile? @relation("Avatar")
  groupAvatar Chat? @relation("GroupAvatar")
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
  @@index([chatId])
  @@index([messageId])
}
